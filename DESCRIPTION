Package: DLNMLPS
Title: Flexible Bayesian Distributed Lag Non-Linear Models
Version: 0.1.0
Authors@R: c(
    person("Sara", "Rutten", "sara.rutten@uhasselt.be", role = c("aut", "cre")),
